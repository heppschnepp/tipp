{
  "name": "tipp-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "World Cup 2026 Prediction Game",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "concurrently \"pnpm --filter tipp-server dev\" \"pnpm --filter tipp-client dev\"",
    "build": "pnpm --parallel --filter \"*\" build",
    "lint": "pnpm --parallel --filter \"*\" lint",
    "type-check": "pnpm --parallel --filter \"*\" type-check",
    "clean": "pnpm --recursive clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "client:dev": "pnpm --filter tipp-client dev",
    "client:build": "pnpm --filter tipp-client build",
    "client:preview": "pnpm --filter tipp-client preview",
    "server:dev": "pnpm dev --filter tipp-server",
    "server:build": "pnpm build --filter tipp-server",
    "server:start": "pnpm start --filter tipp-server",
    "server:seed": "pnpm seed --filter tipp-server",
    "server:migrate": "pnpm migrate --filter tipp-server",
    "server:type-check": "pnpm type-check --filter tipp-server",
    "server:lint": "pnpm lint --filter tipp-server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
